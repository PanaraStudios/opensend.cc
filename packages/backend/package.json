{
  "name": "@opensend/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Convex backend: schema, functions and the generated API. Apps import the API and types from here (@opensend/backend/api, /dataModel). Deployed from the repo root (convex.json) or, in the migrate image, from this folder.",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./server": "./convex/_generated/server.js",
    "./*": "./convex/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p convex",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/client-ses": "^3.1136.0",
    "@aws-sdk/client-sesv2": "3.1131.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/client-sts": "^3.1136.0",
    "@aws-sdk/credential-providers": "^3.1136.0",
    "@better-auth/oauth-provider": "1.6.15",
    "@convex-dev/aggregate": "0.3.1",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/migrations": "0.3.6",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/workflow": "^0.4.8",
    "@convex-dev/workpool": "0.4.12",
    "@opensend/core": "workspace:*",
    "@opensendcc/call-gateway": "workspace:*",
    "@opensendcc/sdk": "workspace:*",
    "@react-email/render": "^2.1.0",
    "better-auth": "1.6.15",
    "convex": "^1.46.0",
    "convex-helpers": "0.1.127",
    "jose": "6.1.3",
    "mailparser": "3.9.29",
    "parse5": "8.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "^20",
    "ajv": "8.20.0",
    "convex-test": "0.0.58",
    "typescript": "^5",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
