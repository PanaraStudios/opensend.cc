  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts lib/dashboard/*.test.ts lib/aws/*.test.ts lib/meta/*.test.ts lib/storage/*.test.ts lib/net/*.test.ts docker/smtp/*.test.mjs docker/migrate/*.test.mjs tests/e2e/*.test.mjs",
