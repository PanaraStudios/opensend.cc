{
  "providerId": "opensend.cc",
  "providerName": "Opensend",
  "serviceId": "ses",
  "serviceName": "Opensend sending domain",
  "version": 1,
  "description": "Verifies a domain for sending email through Amazon SES with Opensend: Easy DKIM, a custom MAIL FROM domain, an optional DMARC policy and optional inbound mail.",
  "variableDescription": "dkim1, dkim2, dkim3: the Easy DKIM tokens SES issued; dkimzone: SES's DKIM signing zone; mailfrom: the MAIL FROM subdomain label; region: the AWS region",
  "syncBlock": false,
  "syncPubKeyDomain": "opensend.cc",
  "hostRequired": false,
  "records": [
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.%dkimzone%",
      "ttl": 300
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.%dkimzone%",
      "ttl": 300
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.%dkimzone%",
      "ttl": 300
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "%mailfrom%",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 300
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "%mailfrom%",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },
    {
      "groupId": "receiving",
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "priority": 10,
      "ttl": 300
    }
  ]
}
