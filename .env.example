# Runtime variables for pnpm dev. pnpm setup creates .env.docker separately.
CONVEX_INTERNAL_URL=http://localhost:3210
CONVEX_INTERNAL_SITE_URL=http://localhost:3211
CONVEX_PUBLIC_URL=http://localhost:3210

# Convex CLI target (convex codegen, editor tooling): the self-hosted backend.
# Copy CONVEX_SELF_HOSTED_ADMIN_KEY from .env.docker. Never set
# CONVEX_DEPLOYMENT as well; the CLI refuses both.
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional overrides in .env.docker before running pnpm setup:
# Anonymous usage statistics are on by default. 0 locks sharing off.
# OPENSEND_TELEMETRY=0
# OPENSEND_TELEMETRY_URL=https://opensend.cc/api/telemetry
# Set this when enabling the calling Compose profiles.
# OPENSEND_CALLING=1
# SITE_URL=https://mail.example.com
# SMTP_HOST=smtp.example.com
# Setup also pushes SMTP_HOST to Convex; if absent, the dashboard uses SITE_URL's hostname.
# CONVEX_PUBLIC_URL=https://realtime.example.com
# CONVEX_PUBLIC_SITE_URL=https://api.example.com
# CONVEX_BACKEND_ORIGIN=https://convex.example.com
# The backend origin must also resolve inside Docker (Node action callbacks).
# Local setup derives host.docker.internal automatically.
# SES encryption is created automatically by the setup wizard.
# Keep SES_ENCRYPTION_KEY only when restoring legacy v1 credentials.
# "Auto configure" is signed by opensend.cc; nothing to set. Overrides are in
# domain-connect/README.md (DOMAIN_CONNECT_SIGNER, or the owner's own key).
# APP_PORT=3000
# CONVEX_PORT=3210
# CONVEX_SITE_PORT=3211
# Dashboard is opt-in: docker compose --profile debug up -d dashboard
# DASHBOARD_PORT=6791

# Prebuilt Compose images default to latest; pin a release for production.
# pnpm setup instead saves local image names for source builds.
# OPENSEND_VERSION=0.1.0
# APP_IMAGE=ghcr.io/panarastudios/opensend-app:0.1.0
# MIGRATE_IMAGE=ghcr.io/panarastudios/opensend-migrate:0.1.0
# SMTP_IMAGE=ghcr.io/panarastudios/opensend-smtp:0.1.0
# Optional Caddy HTTPS proxy (set all three public URLs above):
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml
# DOCUMENT_RETENTION_DELAY=172800
