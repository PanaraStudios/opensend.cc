# Full Stripe + Next.js setup: docs/stripe-sponsors.md
STRIPE_PAYMENT_LINK_GOLD=
STRIPE_PAYMENT_LINK_SILVER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Waitlist contacts. Also used to tag new sponsors.
NEXT_COCOMAIL_API_KEY=

# Optional. Operator mail (new sponsor, uploaded logos) goes through Resend
# when this is set, and through Cocomail when it is not.
# RESEND_API_KEY=

# The address operator mail is sent from. Its domain has to be verified with
# the mail provider. Defaults to the contact address in content/site.ts.
# MAIL_FROM=
