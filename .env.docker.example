# Optional Convex backend S3-compatible storage. Local storage remains the default.
# Set these in your private .env.docker and use the compose.storage.yaml override
# documented in docs/object-storage.md. These belong on the convex container.
# AWS_REGION=your-region
# AWS_ACCESS_KEY_ID=your-backend-storage-access-key
# AWS_SECRET_ACCESS_KEY=your-backend-storage-secret-key
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# S3_STORAGE_EXPORTS_BUCKET=convex-snapshot-exports
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshot-imports
# S3_STORAGE_MODULES_BUCKET=convex-modules
# S3_STORAGE_FILES_BUCKET=convex-user-files
# S3_STORAGE_SEARCH_BUCKET=convex-search-indexes
