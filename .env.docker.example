# Optional durable storage. Leave BUCKET empty for local Convex storage.
# Add these to the environment produced by pnpm setup.
# See docs/object-storage.md for tokens, CORS and migration.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Deliberately public team assets only.
OBJECT_STORAGE_PUBLIC_BASE_URL=
